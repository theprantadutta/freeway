# Application Port
PORT=8080

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_NAME=freeway

# Or use a full connection string (takes precedence over individual values)
# DATABASE_URL=Host=localhost;Port=5432;Database=freeway;Username=postgres;Password=your-password

# API Keys
ADMIN_API_KEY=your-admin-api-key
OPENROUTER_API_KEY=sk-or-your-openrouter-key

# AI Provider API Keys (for multi-provider fallback)
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
COHERE_API_KEY=your-cohere-api-key
HUGGINGFACE_API_KEY=your-huggingface-api-key
MISTRAL_API_KEY=your-mistral-api-key

# Application Settings
API_KEY_PREFIX=fw_
REQUEST_TIMEOUT_SECONDS=30
COMPLETION_TIMEOUT_SECONDS=120

# Paid/image model fallback: number of backup models to try after the primary,
# and how long a rate-limited (429) model is skipped before being retried.
PAID_FALLBACK_COUNT=3
MODEL_COOLDOWN_SECONDS=60

# Paid tiers. A chat request picks one with "model": "paid:low" | "paid:moderate" |
# "paid:premium"; bare "paid" means "paid:low". A tier is defined by a curated preference
# list (tried first, in order) and a price band in combined USD per million tokens that
# classifies everything else and supplies the fallback chain.
#
# Band edges: low is < LOW_MAX, moderate is < MODERATE_MAX, premium is everything above.
PAID_TIER_LOW_MAX=1.0
PAID_TIER_MODERATE_MAX=10.0

# Curated preference lists, best-first, comma-separated. Leave unset to use the defaults
# baked into PaidTierCatalog. A model named here belongs to that tier regardless of price.
PAID_TIER_MODERATE_MODELS=
PAID_TIER_PREMIUM_MODELS=

# OpenRouter provider routing: prefer the fastest/healthiest endpoint and let
# OpenRouter route around a throttled provider serving the same model. This cuts
# 429s without changing model selection. OPENROUTER_IGNORE_PROVIDERS is a
# comma-separated blocklist of provider slugs (e.g. novita).
OPENROUTER_PROVIDER_SORT=throughput
OPENROUTER_ALLOW_FALLBACKS=true
OPENROUTER_IGNORE_PROVIDERS=

# JWT Authentication (for web frontend)
JWT_SECRET=your-super-secret-jwt-key-min-32-characters
JWT_EXPIRY_HOURS=24

# Default Admin User (seeded on first startup)
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=change-this-password

# Hangfire Dashboard (optional)
HANGFIRE_USERNAME=admin
HANGFIRE_PASSWORD=your-hangfire-password

# CORS (comma-separated origins, or * for all)
ALLOWED_ORIGINS=*

# Environment
ASPNETCORE_ENVIRONMENT=Development

# ---------------------------------------------------------------------------
# Email notifications
# ---------------------------------------------------------------------------
# Gmail requires an App Password (not the account password) with 2FA enabled.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-16-char-gmail-app-password
SMTP_FROM=you@gmail.com
SMTP_FROM_NAME=Freeway
SMTP_USE_STARTTLS=true

# Where every report and alert is sent.
ADMIN_NOTIFICATION_EMAIL=you@gmail.com

# Weekly usage report. Cron is UTC; default is Monday 03:00 UTC.
WEEKLY_REPORT_ENABLED=true
WEEKLY_REPORT_CRON=0 3 * * 1

# Spend and credit alerts. Checked hourly by default.
SPEND_ALERTS_ENABLED=true
SPEND_ALERT_CRON=0 * * * *

# How long one alert stays quiet after firing, so a runaway key sends one email.
ALERT_COOLDOWN_HOURS=12

# Thresholds. All in USD unless the name says otherwise.
ALERT_GLOBAL_DAILY_USD=5
ALERT_PROJECT_DAILY_USD=2
ALERT_PROJECT_DAILY_REQUESTS=5000
ALERT_MODEL_DAILY_USD=3
ALERT_MONTHLY_USD=25
ALERT_OPENROUTER_CREDIT_USD=2
ALERT_OPENROUTER_KEY_REMAINING_USD=1
ALERT_OPENROUTER_KEY_EXPIRY_DAYS=14

# Provider credential health. Every configured provider is asked for its model list
# each check; any that rejects the key raises an alert. Only OpenRouter publishes an
# expiry date, so for the rest "expired" is observed as "stopped being accepted".
CREDENTIAL_ALERTS_ENABLED=true

# How many of OpenRouter's zero-cost models the free lane may try after the direct
# free providers. 0 disables that rung. Only models priced at zero are ever used.
FREE_LANE_OPENROUTER_COUNT=3
